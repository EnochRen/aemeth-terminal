{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aemeth Terminal",
  "version": "0.4.0",
  "identifier": "aemeth-terminal",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aemeth Terminal",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "theme": "Dark",
        "decorations": false,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
