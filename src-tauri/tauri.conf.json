{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aemeth Terminal",
  "version": "0.2.0",
  "identifier": "dev.aemeth.terminal",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aemeth Terminal",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "theme": "Dark",
        "decorations": false,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3MEE1N0FCRkRFOEQ2N0MKUldSODF1ajlxMWNLcDh3ZVFGVjZzdTZ3WFlmUkFUOUFicFNITmRvTmlGYnpoNm83SWQxMDBiQVAK",
      "endpoints": [
        "https://github.com/EnochRen/aemeth-terminal/releases/latest"
      ]
    }
  }
}
